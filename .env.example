# Copy to .env and fill in keys when adapters need them.
# Never commit real secrets.

EBAY_APP_ID=
EBAY_DEV_ID=
EBAY_CERT_ID=
# Sandbox is a separate eBay with its own keyset and almost no listings: searches
# there succeed and return nothing. Keep this false unless you are testing auth.
EBAY_SANDBOX=false
FX_PROVIDER=frankfurter
DEFAULT_DESTINATION_COUNTRY=TR
DEFAULT_REFERENCE_CURRENCY=TRY
OFFER_CACHE_TTL_SECONDS=900
